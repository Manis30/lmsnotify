# Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lms?retryWrites=true&w=majority

# Brevo (Sendinblue) API Key for Transactional Emails & Event Webhooks/Polling
BREVO_API_KEY=your_brevo_api_key_here

# Email Sender Details
MAIL_FROM=maninature121@gmail.com
SENDER_NAME=LMS Notify Team

# Allowed Client URLs for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:3000,http://localhost:5173,https://lmsnotify.vercel.app

# Optional Email Template Overrides
EMAIL_SUBJECT=Enhance Your Teaching Experience with Our Learning Platform
APPLICATION_LINK=https://lms-notify.example.com
SUPPORT_EMAIL=support@lms-notify.example.com
